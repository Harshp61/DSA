class Solution {
public:
    bool isAnagram(string s, string t) { 
        sort(s.begin(), s.end());
        sort(t.begin(), t.end());
        return s == t; 
    }
};

//Sorted and matched , as "An anagram is a word or phrase formed by rearranging the letters of a different word or phrase, using all the original letters exactly once."
